# Copie este arquivo para .env e ajuste os valores

# ── Backend obrigatório ────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-string-aleatoria-longa
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=SuaSenhaForte!
ADMIN_NOME=Admin

# ── Admin extra opcional (conta adicional criada a cada boot se definida) ──
# EXTRA_ADMIN_EMAIL=outro@exemplo.com
# EXTRA_ADMIN_NOME=Outro Admin
# EXTRA_ADMIN_SENHA=OutraSenhaForte!

# ── Origens CORS permitidas (separadas por vírgula) ────────────────────────
# CORS_ORIGINS=https://seuapp.streamlit.app,http://localhost:8501

# ── Frontend ───────────────────────────────────────────────────────────────
# Adicione em .streamlit/secrets.toml (não versionar):
# API_URL = "http://localhost:8000"
