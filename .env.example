# Copie este arquivo para .env e ajuste os valores

# Banco de dados
# Desenvolvimento local (docker-compose):
DATABASE_URL=postgresql://agencia_user:agencia_pass@localhost:5432/agencia_empregos

# Produção (AWS RDS) — basta trocar esta variável, sem alterar código:
# DATABASE_URL=postgresql://usuario:senha@endpoint-do-rds.rds.amazonaws.com:5432/agencia_empregos

POSTGRES_DB=agencia_empregos
POSTGRES_USER=agencia_user
POSTGRES_PASSWORD=agencia_pass
